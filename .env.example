# Nextcloud Passwords MCP server configuration.
# Copy to `.env` for local development (never commit the real file).

# Base URL of your Nextcloud instance (no trailing slash). Must be https://.
NEXTCLOUD_URL=https://cloud.example.com

# Nextcloud username.
NEXTCLOUD_USER=your-username

# A dedicated Nextcloud APP PASSWORD — never your real account password.
# Generate under Settings > Security > Devices & sessions > "Create new app password".
NEXTCLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx-xxxx

# Optional: print debug logs to stderr (never logs secrets). Default: off.
# DEBUG=1

# Optional: allow plaintext http:// (localhost testing ONLY — sends credentials
# in the clear). Default: false. Leave unset in production.
# ALLOW_INSECURE_HTTP=true
