{
  "name": "passwords-mcp",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol server for the Nextcloud Passwords app",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "passwords-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "prepublishOnly": "tsc",
    "pack:tarball": "tsc && npm pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@9.15.9"
}
